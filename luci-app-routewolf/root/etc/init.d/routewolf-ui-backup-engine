#!/bin/sh /etc/rc.common
USE_PROCD=1

start_service() {
    [ "$(uci -q get routewolf_ui.ui.backup_device)" = rwsubb0 ] || return 0
    local config=/etc/routewolf-ui/backup-proxy/config.json
    local binary=sing-box
    if grep -qx xray /etc/routewolf-ui/backup-proxy/engine 2>/dev/null; then binary=xray; fi
    binary=$(command -v "$binary") || return 1
    [ -s "$config" ] || return 1
    procd_open_instance
    procd_set_param command "$binary" run -c "$config"
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
