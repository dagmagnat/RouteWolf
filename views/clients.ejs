          </div>
        </div>
        <div class="alert ok import-safe-note">По умолчанию удалённые узлы не изменяются. Перед началом синхронизации выбранные узлы проверяются один раз; недоступный узел пропускается целиком, а не создаёт тайм-аут для каждого клиента.</div>
        <button type="submit" class="btn-main">Запустить импорт</button>
      </form>
    </div>

    <div class="modal-section-box">
      <h3>Добавить отсутствующих клиентов на один узел</h3>
      <p class="muted">Проверяет выбранный сервер один раз, читает его текущих клиентов и создаёт только отсутствующих. В Remnawave существующий пользователь не перезаписывается, но недостающий настроенный Internal Squad безопасно добавляется, чтобы Host появился в подписке.</p>
      <form method="post" action="/clients/create-missing-on-node" class="js-long-action" data-loading-title="Добавляю отсутствующих клиентов" data-loading-text="Существующие клиенты будут пропущены. На экране выполнения доступна безопасная отмена.">
        <label>Целевой узел</label>
        <select name="node_id" required>
          <option value="">Выберите узел</option>
          <% nodes.forEach(node => { %>
            <option value="<%= node.id %>" data-node-type="<%= String(node.node_type || '3xui') %>"><%= flagText(node.country_code, node.country_flag, node.country_name_ru || node.name) %> <%= nodeName(node) %> (<%= nodeEndpointLabel(node) %>)</option>
          <% }) %>
        </select>
        <div class="alert ok">Безопасный режим: совпадения по UUID/email/subId не пересоздаются. Совпадение email с другим UUID считается конфликтом. Для Remnawave при совпадении добавляется только отсутствующий Internal Squad.</div>
        <button type="submit" class="btn-main">Создать только отсутствующих</button>
      </form>
    </div>

    <div class="modal-section-box">
      <h3>Синхронизировать выбранные узлы</h3>
      <p class="muted">Создаёт или обновляет клиентов агрегатора только на отмеченных серверах. Автоматический выбор всех активных узлов отключён.</p>
      <form method="post" action="/clients/sync-nodes" class="js-long-action" data-loading-title="Идёт синхронизация" data-loading-text="Агрегатор обрабатывает только выбранные узлы. На экране выполнения будет кнопка безопасной отмены.">
        <div class="nodes-head node-bulk-head">
          <label>Узлы для синхронизации</label>
          <div class="node-select-actions">
            <button type="button" class="btn-secondary" onclick="return setOperationNodeSelection(this, 'node_ids', true)">Выбрать все</button>
            <button type="button" class="btn-secondary" onclick="return setOperationNodeSelection(this, 'node_ids', false)">Снять все</button>
          </div>
        </div>
        <div class="checkbox-list node-list operation-node-list">
          <% nodes.forEach(node => { %>
            <label class="node-item">
              <input class="node-check" type="checkbox" name="node_ids" value="<%= node.id %>" />
              <span class="node-info">
                <strong><%- flagIcon(node.country_code, node.country_flag, node.country_name_ru || node.name, node.node_type) %><span><%= nodeName(node) %></span></strong>
                <small><%= nodeEndpointLabel(node) %></small>
              </span>
            </label>
          <% }) %>
        </div>
        <button type="submit" class="btn-secondary">Синхронизировать выбранные узлы</button>
      </form>
    </div>
  </div>
</div>

<div id="applyAllModal" class="modal hidden" onclick="closeModalById(event, 'applyAllModal')">
  <div class="modal-card editor-modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="event.preventDefault(); event.stopPropagation(); hideModalById('applyAllModal'); return false;">×</button>
    <h2>Применить к выбранным</h2>
    <p class="muted">На выбранном узле будут созданы отсутствующие клиенты и обновлены уже существующие. Пустые лимиты сохраняют текущие значения клиента; 0 = безлимит. Потраченный трафик не сбрасывается.</p>
    <div class="alert ok" id="applySelectedSummary">Выбрано клиентов: 0</div>
    <p class="muted" id="applySelectedNames"></p>
    <form id="applySelectedForm" method="post" action="/clients/apply-to-node" class="js-long-action" data-loading-title="Применяю выбранных клиентов" data-loading-text="На выбранном узле создаются или обновляются только явно отмеченные клиенты." onsubmit="return prepareApplySelectedSubmit(event)">
      <div class="form-grid clean-form">
        <div class="field">
          <label>Узел, куда добавить или обновить клиентов</label>
          <select name="node_id" required>
            <% nodes.forEach(node => { %>
              <option value="<%= node.id %>" data-node-type="<%= String(node.node_type || '3xui') %>"><%= flagText(node.country_code, node.country_flag, node.country_name_ru || node.name) %> <%= nodeName(node) %> (<%= nodeEndpointLabel(node) %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="field half">
          <label>Лимит IP</label>
          <input name="limit_ip" type="number" min="0" placeholder="сохранить текущий" />
        </div>
        <div class="field half">
          <label>Лимит ГБ</label>
          <input name="traffic_gb" type="number" min="0" step="1" placeholder="сохранить текущий" />
        </div>
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn-main">Применить к выбранным</button>
      </div>
    </form>
  </div>
</div>

<div class="card danger-zone-card">
  <h2>Массовое удаление</h2>
  <form id="deleteAllClientsForm" method="post" action="/clients/delete-all" class="js-long-action" data-loading-title="Удаляю всех клиентов" data-loading-text="Недоступные и удалённые узлы будут пропущены; локальные связи будут очищены." onsubmit="return openDeleteAllClientsConfirm(event)">
    <input type="hidden" name="delete_all_confirmation" value="" id="deleteAllConfirmation" />
    <label>Режим удаления</label>
    <select name="delete_mode" id="deleteAllMode">
      <option value="aggregator">Только из агрегатора</option>
      <option value="secondary">Из агрегатора и вторичных узлов</option>
      <option value="all">Из агрегатора и всех узлов</option>
    </select>
    <button class="danger" type="submit">Удалить всех клиентов</button>
  </form>
</div>

<div id="deleteAllClientsModal" class="modal hidden" onclick="closeDeleteAllClientsConfirm(event)">
  <div class="modal-card delete-all-confirm-card" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideDeleteAllClientsConfirm()">×</button>
    <h2>Удалить всех клиентов?</h2>
    <p class="muted">Это массовая операция. Недоступные, отключённые и уже удалённые узлы будут пропущены, а их старые локальные связи — очищены.</p>
    <div class="alert err" id="deleteAllModeSummary">Режим удаления не выбран.</div>
    <label for="deleteAllTypedYes">Для подтверждения напишите <strong>YES</strong></label>
    <input id="deleteAllTypedYes" autocomplete="off" placeholder="YES" />
    <div class="modal-actions">
      <button type="button" class="btn-secondary" onclick="hideDeleteAllClientsConfirm()">Отмена</button>
      <button type="button" class="danger" id="deleteAllConfirmButton" onclick="submitDeleteAllClients()" disabled>Удалить всех клиентов</button>
    </div>
  </div>
</div>

<% clients.forEach(client => {
  const clientEnabled = client.enabled !== 0;
  const clientReturnPath = '/clients?' + new URLSearchParams({ ...(q ? { q } : {}), edit: String(client.id) }).toString();
  const editorSubUrl = `${baseUrl}/sub/${client.sub_slug}`;
  const editorJsonUrl = `${baseUrl}/json/${client.sub_slug}`;
  const editorHappUrl = `${baseUrl}/happ/${client.sub_slug}`;
  const hasVisibleClientLinks = Boolean(showSubLinks || showJsonLinks || showHappLinks);
%>
  <div id="clientEditor-<%= client.id %>" class="modal hidden" onclick="closeClientEditor(event, <%= client.id %>)">
    <div class="modal-card editor-modal client-editor-modal existing-client-editor-modal" onclick="event.stopPropagation()">
      <button type="button" class="modal-close" onclick="event.preventDefault(); event.stopPropagation(); hideClientEditor(<%= client.id %>); return false;">×</button>
      <h2>Клиент: <%= compactTitle(client) %></h2>
      <p class="muted">Подробная информация и редактор клиента в одном окне.</p>
      <div class="client-detail-summary">
        <div><span>ID</span><strong><%= client.id %></strong></div>
        <div><span>UUID</span><code><%= client.uuid %></code></div>
        <div><span>Статус</span><strong class="badge <%= clientStatusMeta(client).key %>"><%= clientStatusMeta(client).label %></strong></div>
        <div><span>Срок</span><strong><%= termShort(client) %> дн.</strong><small>до: <%= expiryDateTime(client.expiry_time) %></small></div>
        <div><span>Общий лимит</span><strong><%= client.traffic_gb && client.traffic_gb > 0 ? client.traffic_gb + ' ГБ' : '∞' %></strong></div>
        <div><span>Лимит IP</span><strong><%= client.limit_ip && Number(client.limit_ip) > 0 ? client.limit_ip : '∞' %></strong></div>
        <div>
          <span>Подписка</span>
          <div class="client-summary-link-actions">
            <% if (hasVisibleClientLinks) { %><button type="button" class="btn-secondary compact-copy-btn" data-client-link-title="<%= client.login %>" data-json-link="<%= showJsonLinks ? editorJsonUrl : '' %>" data-sub-link="<%= showSubLinks ? editorSubUrl : '' %>" data-happ-link="<%= showHappLinks ? editorHappUrl : '' %>" onclick="openClientLinkPicker(this, 'copy')">Копировать</button><% } else { %><span class="muted">Скрыта в настройках</span><% } %>
          </div>
        </div>
        <div>
          <span>QR</span>
          <div class="client-summary-link-actions">
            <% if (hasVisibleClientLinks) { %><button type="button" class="btn-secondary" data-client-link-title="<%= client.login %>" data-json-link="<%= showJsonLinks ? editorJsonUrl : '' %>" data-sub-link="<%= showSubLinks ? editorSubUrl : '' %>" data-happ-link="<%= showHappLinks ? editorHappUrl : '' %>" onclick="openClientLinkPicker(this, 'qr')">Показать QR</button><% } else { %><span class="muted">Скрыт</span><% } %>
          </div>
        </div>
      </div>

      <form method="post" action="/clients/<%= client.id %>/edit" class="js-long-action" data-loading-title="Сохраняю клиента" data-loading-text="Изменения применяются на узлах клиента. Это может занять время.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <div class="form-grid clean-form">
          <div class="field half">
            <label>Имя клиента</label>
            <input name="display_name" value="<%= client.display_name %>" required />
          </div>
          <div class="field half">
            <label>Логин / Email</label>
            <input name="login" value="<%= client.login %>" required />
          </div>
          <div class="field half">
            <label>Комментарий</label>
            <input name="comment" value="<%= client.comment || '' %>" placeholder="Заметка для поиска" />
          </div>
          <div class="field half">
            <label>Лимит IP</label>
            <input name="limit_ip" type="number" min="0" value="<%= client.limit_ip ?? 1 %>" />
          </div>
          <div class="field half">
            <label>Новый срок в днях</label>
            <input name="duration_days" type="number" min="0" value="" placeholder="не менять" />
            <small class="hint">Сейчас: <%= termShort(client) %> дн., до <%= expiryDateTime(client.expiry_time) %>. Пусто = не менять, 0 = убрать срок.</small>
          </div>
          <div class="field half">
            <label>Общий лимит трафика, ГБ</label>
            <input name="traffic_gb" type="number" min="0" step="1" value="<%= client.traffic_gb || 0 %>" />
          </div>
        </div>

        <div class="nodes-head node-bulk-head edit-node-bulk-head">
          <div>
            <h3>Узлы клиента</h3>
            <p class="muted">Снимите галочку, чтобы отключить клиенту конкретный узел. Поле ГБ задаёт лимит только для этого региона; пусто = общий лимит.</p>
          </div>
          <div class="node-select-actions" aria-label="Быстрый выбор узлов клиента">
            <button type="button" class="btn-secondary node-select-btn" data-node-check-set="all" aria-pressed="false" onclick="event.stopPropagation(); return setClientNodeSelection(this, true)">Выбрать все</button>
            <button type="button" class="btn-secondary node-select-btn" data-node-check-set="none" aria-pressed="false" onclick="event.stopPropagation(); return setClientNodeSelection(this, false)">Снять все</button>
          </div>
        </div>
        <div class="checkbox-list node-list">
          <% client.node_limits.forEach(row => {
            const nodeLabel = nodeName(row);
          %>
            <label class="node-item node-edit-row">
              <input class="inline" type="checkbox" name="node_enabled_<%= row.node_id %>" value="1" <%= row.client_node_id && row.enabled !== 0 ? 'checked' : '' %> />
              <span class="node-info"><strong><%- flagIcon(row.country_code, row.country_flag, row.country_name_ru || row.node_name || row.name, row.node_type) %><span><%= nodeLabel %></span></strong><small><%= row.client_node_id ? (row.enabled !== 0 ? 'узел включён' : 'узел отключён для клиента') : 'узел не назначен' %></small></span>
              <input class="node-gb-input" name="node_traffic_gb_<%= row.node_id %>" type="number" min="0" step="1" value="<%= row.traffic_gb || '' %>" placeholder="ГБ" />
            </label>
          <% }) %>
        </div>
        <div class="modal-actions">
          <button type="submit" class="btn-main">Сохранить</button>
        </div>
      </form>

      <hr class="soft-sep" />

      <form method="post" action="/clients/<%= client.id %>/extend" class="extend-form js-long-action" data-loading-title="Продлеваю клиента" data-loading-text="Срок продлевается на узлах клиента.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <label>Продлить срок</label>
        <div class="btn-row stretch-row">
          <input name="days" type="number" min="1" value="30" />
          <button type="submit" class="btn-main">Продлить на дней</button>
        </div>
      </form>

      <form method="post" action="/clients/<%= client.id %>/toggle" class="modal-actions js-long-action" data-loading-title="Меняю статус" data-loading-text="Статус клиента применяется на узлах.">
        <input type="hidden" name="back" value="<%= clientReturnPath %>" />
        <button type="submit" class="<%= clientEnabled ? 'btn-danger' : 'btn-secondary' %>"><%= clientEnabled ? 'Отключить клиента' : 'Включить клиента' %></button>
      </form>
    </div>
  </div>
<% }) %>

<% clients.forEach(client => { %>
  <% const details = (client.node_limits || []).filter(nl => nl.client_node_id && ((nl.traffic_gb && nl.traffic_gb > 0) || nl.enabled === 0)); %>
  <% if (details.length) { %>
    <div id="limitDetails-<%= client.id %>" class="modal hidden" onclick="closeLimitDetails(event, <%= client.id %>)">
      <div class="modal-card limit-details-card" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="hideLimitDetails(<%= client.id %>)">×</button>
        <h2>Лимиты узлов</h2>
        <p class="muted"><%= client.login %></p>
        <div class="limit-details-list">
          <% details.forEach(nl => { %>
            <div class="limit-details-row <%= nl.enabled === 0 ? 'disabled' : '' %>">
              <span><%= nodeName(nl) %><% if (nl.transport_label) { %> <em class="transport-chip"><%= nl.transport_label %></em><% } %></span>
              <strong><%= nodeLimitText(nl) %></strong>
              <% if (nl.enabled !== 0 && nl.traffic_gb > 0) { %><small>осталось <%= nodeRemainingText(nl) %></small><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>
<% }) %>

<% } else { %>
  <div id="createVpnClientModal" class="modal hidden" onclick="closeModalById(event, 'createVpnClientModal')">
    <div class="modal-card editor-modal client-editor-modal create-client-editor-modal" onclick="event.stopPropagation()">
      <button type="button" class="modal-close" onclick="hideModalById('createVpnClientModal')">×</button>
      <h2>Создать клиента: <%= currentClientTypeLabel %></h2>
      <% if (!vpnServices.length) { %>
        <div class="alert err">Нет установленного сервиса этого типа. Сначала откройте «VPN-сервисы», создайте сервис и выполните установку.</div>
        <div class="modal-actions"><a class="link-btn" href="/vpn?tab=services">Перейти к сервисам</a></div>
      <% } else { %>
        <form method="post" action="/vpn/services/<%= vpnServices[0].id %>/clients" id="clientsVpnCreateForm" class="js-long-action" data-loading-title="Создаю VPN-клиента" data-loading-text="Панель создаёт ключи и добавляет клиента на выбранный VPS.">
          <input type="hidden" name="back" value="/clients?type=<%= clientType %>" />
          <div class="form-grid clean-form">
            <div class="field half">
              <label>VPN-сервис</label>
              <select id="clientsVpnService" required>
                <% vpnServices.forEach(service => { %>
                  <option value="<%= service.id %>"><%= vpnProtocolLabels[service.protocol] || service.protocol %> · <%= service.name %> · <%= service.host_name %></option>
                <% }) %>
              </select>
            </div>
            <div class="field half">
              <label>Имя клиента</label>
              <input name="name" required placeholder="Например: iphone-alex" autocomplete="off" />
            </div>
            <div class="field half">
              <label>Связать с основным клиентом</label>
              <select name="aggregator_client_id">
                <option value="">Не связывать</option>
                <% vpnAggregatorClients.forEach(item => { %><option value="<%= item.id %>"><%= item.display_name || item.login %> · <%= item.login %></option><% }) %>
              </select>
            </div>
            <div class="field half">
              <label>Срок доступа, дней</label>
              <input name="duration_days" type="number" min="0" max="3650" value="30" required />
              <small class="hint">0 — без ограничения.</small>
            </div>
          </div>
          <div class="modal-actions"><button type="submit" class="btn-main">Создать конфигурацию</button></div>
        </form>
      <% } %>
    </div>
  </div>

  <% vpnClients.forEach(client => {
    const expires = Number(client.expires_at || 0);
    const returnPath = '/clients?type=' + encodeURIComponent(clientType) + (q ? '&q=' + encodeURIComponent(q) : '');
  %>
    <div id="vpnClientEditor-<%= client.id %>" class="modal hidden" onclick="closeModalById(event, 'vpnClientEditor-<%= client.id %>')">
      <div class="modal-card editor-modal client-editor-modal existing-client-editor-modal" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="hideModalById('vpnClientEditor-<%= client.id %>')">×</button>
        <h2><%= client.name %></h2>
        <p class="muted"><%= vpnProtocolLabels[client.protocol] || client.protocol %> · <%= client.service_name %> · <%= client.host_name %></p>
        <div class="client-detail-summary vpn-client-detail-summary">
          <div><span>ID</span><strong><%= client.id %></strong></div>
          <div><span>Адрес</span><code><%= client.address || 'Outline key' %></code></div>
          <div><span>Статус</span><strong><%= client.enabled === 0 ? 'Отключён' : 'Активен' %></strong></div>
          <div><span>Действует до</span><strong><%= expires > 0 ? new Date(expires).toLocaleString('ru-RU') : 'Без ограничения' %></strong></div>
        </div>
        <div class="vpn-editor-downloads">
          <a class="link-btn" href="/vpn/clients/<%= client.id %>/config">Скачать конфигурацию</a>
          <button type="button" class="btn-secondary" data-vpn-qr-url="/vpn/clients/<%= client.id %>/qr" data-vpn-qr-title="<%= client.name %>" onclick="showVpnQr(this.dataset.vpnQrUrl, this.dataset.vpnQrTitle)">Показать QR-код</button>
        </div>
        <form method="post" action="/vpn/clients/<%= client.id %>/rename" class="form-grid vpn-client-rename-form">
          <input type="hidden" name="back" value="<%= returnPath %>" />
          <label>Имя клиента<input name="name" value="<%= client.name %>" required /></label>
          <div class="button-row"><button type="submit" class="btn-main">Сохранить имя</button></div>
        </form>
        <form method="post" action="/vpn/clients/<%= client.id %>/extend" class="vpn-editor-inline-form">
          <input type="hidden" name="back" value="<%= returnPath %>" />
          <label>Продлить<input name="days" type="number" min="0" max="3650" value="30" /></label>
          <button type="submit" class="btn-secondary">Продлить</button>
        </form>
        <div class="modal-actions vpn-editor-danger-actions">
          <form method="post" action="/vpn/clients/<%= client.id %>/toggle">
            <input type="hidden" name="back" value="<%= returnPath %>" />
            <button type="submit" class="btn-secondary"><%= client.enabled === 0 ? 'Включить' : 'Отключить' %></button>
          </form>
          <form method="post" action="/vpn/clients/<%= client.id %>/delete" onsubmit="return confirm('Удалить VPN-клиента с сервера и из агрегатора?')">
            <input type="hidden" name="back" value="<%= returnPath %>" />
            <button type="submit" class="danger">Удалить</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>

<div id="loadingModal" class="modal hidden loading-modal" aria-live="polite">
  <div class="modal-card loading-card">
    <div class="loader-ring"></div>
    <h2 id="loadingTitle">Загрузка</h2>
    <p class="muted" id="loadingText">Операция выполняется. Не закрывайте страницу.</p>
  </div>
</div>

<div id="qrModal" class="modal hidden" onclick="hideQr(event)">
  <div class="modal-card" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="closeQr()">×</button>
    <h2 id="qrTitle">QR</h2>
    <img id="qrImg" alt="QR" />
    <p class="muted" id="qrText"></p>
  </div>
</div>

<script>
const clientDirectoryMode = <%= clientType === 'xray' ? 'true' : 'false' %>;
const clientDirectoryInitialQuery = new URLSearchParams(window.location.search).get('q') || '';
let clientDirectoryState = { query: clientDirectoryInitialQuery, nodeId: '', sort: 'newest' };
const clientDirectorySortModes = ['newest','oldest','name-asc','name-desc','expiring','expired','disabled'];

function normalizeClientDirectoryText(value) {
  return String(value || '').toLocaleLowerCase('ru-RU').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
}
function getClientDirectoryEntries(view) {
  const selector = view ? `[data-client-entry][data-client-view="${view}"]` : '[data-client-entry]';
  return Array.from(document.querySelectorAll(selector));
}
function getVisibleClientDirectoryIds() {
  const ids = new Set();
  getClientDirectoryEntries().forEach(entry => {
    if (!entry.classList.contains('is-directory-hidden')) {
      const id = String(entry.dataset.clientIdEntry || '');
      if (id) ids.add(id);
    }
  });
  return ids;
}
function compareClientDirectoryEntries(a, b) {
  const mode = clientDirectoryState.sort;
  const ai = Number(a.dataset.clientOrder || 0);
  const bi = Number(b.dataset.clientOrder || 0);
  const ae = Number(a.dataset.clientExpiryOrder || 0);
  const be = Number(b.dataset.clientExpiryOrder || 0);
  const an = normalizeClientDirectoryText(a.dataset.clientName || '');
  const bn = normalizeClientDirectoryText(b.dataset.clientName || '');
  if (mode === 'oldest') return ai - bi;
  if (mode === 'name-asc') return an.localeCompare(bn, 'ru', { numeric: true, sensitivity: 'base' }) || bi - ai;
  if (mode === 'name-desc') return bn.localeCompare(an, 'ru', { numeric: true, sensitivity: 'base' }) || bi - ai;
  if (mode === 'expiring') return (ae || Number.MAX_SAFE_INTEGER) - (be || Number.MAX_SAFE_INTEGER) || bi - ai;
  if (mode === 'expired') return be - ae || bi - ai;
  if (mode === 'disabled') return bi - ai;
  return bi - ai;
}
function reorderClientDirectory() {
  [
    ['.mobile-client-cards', 'mobile'],
    ['.desktop-client-split-list', 'desktop'],
    ['.clients-table tbody', 'table'],
    ['.clients-modern-table tbody', 'modern']
  ].forEach(([containerSelector, view]) => {
    const container = document.querySelector(containerSelector);
    if (!container) return;
    getClientDirectoryEntries(view).sort(compareClientDirectoryEntries).forEach(entry => container.appendChild(entry));
  });
}
function syncClientDirectorySearchInputs(source) {
  document.querySelectorAll('form[data-client-directory-search] input[name="q"]').forEach(input => {
    if (input !== source && input.value !== clientDirectoryState.query) input.value = clientDirectoryState.query;
  });
}
function updateClientDirectoryUrl() {
  if (!window.history || !window.history.replaceState) return;
  const url = new URL(window.location.href);
  if (clientDirectoryState.query) url.searchParams.set('q', clientDirectoryState.query); else url.searchParams.delete('q');
  if (clientDirectoryState.nodeId) url.searchParams.set('node_id', clientDirectoryState.nodeId); else url.searchParams.delete('node_id');
  if (clientDirectoryState.sort && clientDirectoryState.sort !== 'newest') url.searchParams.set('sort', clientDirectoryState.sort); else url.searchParams.delete('sort');
  url.searchParams.delete('edit');
  window.history.replaceState({}, '', url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
}
function applyClientDirectoryFilters(options = {}) {
  if (!clientDirectoryMode) return;
  const query = normalizeClientDirectoryText(clientDirectoryState.query);
  const nodeId = String(clientDirectoryState.nodeId || '');
  const statusMode = ['expiring','expired','disabled'].includes(clientDirectoryState.sort) ? clientDirectoryState.sort : '';
  const visibleIds = new Set();
  const master = new Map();
  getClientDirectoryEntries().forEach(entry => {
    const id = String(entry.dataset.clientIdEntry || '');
    if (id && !master.has(id)) master.set(id, entry);
  });
  master.forEach((entry, id) => {
    const search = normalizeClientDirectoryText(entry.dataset.clientSearch || '');
    const nodes = String(entry.dataset.clientNodeIds || '').split(/\s+/).filter(Boolean);
    const status = String(entry.dataset.clientStatus || '');
    if ((!query || search.includes(query)) && (!nodeId || nodes.includes(nodeId)) && (!statusMode || status === statusMode)) visibleIds.add(id);
  });
  getClientDirectoryEntries().forEach(entry => {
    const id = String(entry.dataset.clientIdEntry || '');
    const hidden = !visibleIds.has(id);
    entry.classList.toggle('is-directory-hidden', hidden);
    entry.hidden = hidden;
    entry.setAttribute('aria-hidden', hidden ? 'true' : 'false');
    if (hidden) entry.querySelectorAll('.client-check[data-client-id]').forEach(cb => { cb.checked = false; cb.indeterminate = false; });
  });
  reorderClientDirectory();
  const count = document.getElementById('clientDirectoryCount');
  if (count) count.textContent = String(visibleIds.size);
  const empty = document.getElementById('clientDirectoryEmpty');
  if (empty) empty.hidden = visibleIds.size !== 0;
  const titleCount = document.querySelector('.clients-card > .section-title-row .count-chip');
  if (titleCount) titleCount.textContent = String(visibleIds.size);
  syncClientDirectorySearchInputs(options.sourceInput || null);
  syncBulkNodeActionWithFilter();
  updateBulkSelectionUi();
  if (options.updateUrl !== false) updateClientDirectoryUrl();
}
function setupClientDirectory() {
  if (!clientDirectoryMode) return;
  const params = new URLSearchParams(window.location.search);
  clientDirectoryState.query = params.get('q') || clientDirectoryInitialQuery || '';
  clientDirectoryState.nodeId = params.get('node_id') || '';
  clientDirectoryState.sort = clientDirectorySortModes.includes(params.get('sort')) ? params.get('sort') : 'newest';
  const nodeSelect = document.getElementById('clientNodeFilter');
  const sortSelect = document.getElementById('clientSortMode');
  if (nodeSelect) nodeSelect.value = clientDirectoryState.nodeId;
  if (sortSelect) sortSelect.value = clientDirectoryState.sort;
  document.querySelectorAll('form[data-client-directory-search]').forEach(form => {
    const input = form.querySelector('input[name="q"]');
    if (!input) return;
    input.value = clientDirectoryState.query;
    input.addEventListener('input', () => {
      clientDirectoryState.query = input.value;
      applyClientDirectoryFilters({ sourceInput: input });
    });
    form.addEventListener('submit', event => {
      event.preventDefault();
      clientDirectoryState.query = input.value;
      applyClientDirectoryFilters({ sourceInput: input });
      input.focus({ preventScroll: true });
    });
  });
  nodeSelect?.addEventListener('change', () => {
    clientDirectoryState.nodeId = nodeSelect.value;
    applyClientDirectoryFilters();
  });
  document.getElementById('bulkRemoveNodeId')?.addEventListener('change', event => {
    if (!clientDirectoryState.nodeId) return;
    if (String(event.currentTarget.value || '') === String(clientDirectoryState.nodeId)) return;
    event.currentTarget.value = String(clientDirectoryState.nodeId);
    showToast('При активном фильтре удаление выполняется только из выбранного в фильтре узла');
  });
  sortSelect?.addEventListener('change', () => {
    clientDirectoryState.sort = sortSelect.value;
    applyClientDirectoryFilters();
  });
  document.getElementById('clientDirectoryReset')?.addEventListener('click', () => {
    clientDirectoryState = { query: '', nodeId: '', sort: 'newest' };
    if (nodeSelect) nodeSelect.value = '';
    if (sortSelect) sortSelect.value = 'newest';
    applyClientDirectoryFilters();
    const first = document.querySelector('form[data-client-directory-search] input[name="q"]');
    first?.focus({ preventScroll: true });
  });
  applyClientDirectoryFilters({ updateUrl: false });
}

function showToast(text) {
  const el = document.getElementById('toast');
  if (!el) return;
  el.textContent = text || 'Скопировано';
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 1300);
}
function copySubLink(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    if (btn) {
      const old = btn.textContent;
      btn.textContent = 'Скопировано';
      setTimeout(() => btn.textContent = old, 1200);
    }
    showToast('Ссылка скопирована');
  }).catch(() => showToast('Не удалось скопировать'));
}
function getUniqueClientSelection() {
  const selected = new Set();
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    if (cb.checked) selected.add(String(cb.dataset.clientId || cb.value || ''));
  });
  selected.delete('');
  return selected;
}
function getAllClientIdsOnPage() {
  if (clientDirectoryMode) return getVisibleClientDirectoryIds();
  const ids = new Set();
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    const id = String(cb.dataset.clientId || cb.value || '');
    if (id) ids.add(id);
  });
  return ids;
}
function syncClientCheckboxCopies(source) {
  const id = String(source?.dataset?.clientId || source?.value || '');
  if (!id) return;
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    if (cb !== source && String(cb.dataset.clientId || cb.value || '') === id) cb.checked = source.checked;
  });
}
function updateBulkSelectionUi() {
  const selected = getUniqueClientSelection();
  const all = getAllClientIdsOnPage();
  const count = document.getElementById('bulkSelectedCount');
  if (count) count.textContent = `Выбрано: ${selected.size}`;
  document.querySelectorAll('[data-client-select-action="all"]').forEach(btn => {
    const active = all.size > 0 && selected.size === all.size;
    btn.classList.toggle('is-active', active);
    btn.setAttribute('aria-pressed', active ? 'true' : 'false');
  });
  document.querySelectorAll('[data-client-select-action="none"]').forEach(btn => {
    const active = selected.size === 0;
    btn.classList.toggle('is-active', active);
    btn.setAttribute('aria-pressed', active ? 'true' : 'false');
  });
  document.querySelectorAll('[data-bulk-action]').forEach(btn => { btn.disabled = selected.size === 0; });
  const applyButton = document.getElementById('applySelectedToolbarButton');
  if (applyButton) {
    applyButton.disabled = selected.size === 0;
    applyButton.textContent = selected.size ? `Применить к выбранным (${selected.size})` : 'Применить к выбранным';
  }
}
function setAllClientSelection(checked) {
  const visibleIds = getAllClientIdsOnPage();
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    const id = String(cb.dataset.clientId || cb.value || '');
    cb.checked = checked ? visibleIds.has(id) : false;
    cb.indeterminate = false;
  });
  document.querySelectorAll('.clients-table thead input[type="checkbox"]').forEach(cb => {
    cb.checked = !!checked && visibleIds.size > 0;
    cb.indeterminate = false;
  });
  updateBulkSelectionUi();
  showToast(checked ? `Выбраны показанные клиенты: ${visibleIds.size}` : 'Выбор клиентов снят');
  return false;
}
function toggleAllClients(source) {
  setAllClientSelection(Boolean(source && source.checked));
}
function prepareUniqueClientIdsForSubmit(form, selected) {
  if (!form) return;
  form.querySelectorAll('input[data-bulk-client-id]').forEach(input => input.remove());
  form.querySelectorAll('.client-check[data-client-id]').forEach(cb => { cb.disabled = true; });
  selected.forEach(id => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'client_ids';
    input.value = id;
    input.dataset.bulkClientId = '1';
    form.appendChild(input);
  });
}
function getSelectedClientNames(selected, limit = 12) {
  const names = [];
  const seen = new Set();
  getClientDirectoryEntries().forEach(entry => {
    const id = String(entry.dataset.clientIdEntry || '');
    if (!selected.has(id) || seen.has(id)) return;
    seen.add(id);
    names.push(String(entry.dataset.clientName || `ID ${id}`).trim() || `ID ${id}`);
  });
  const visible = names.slice(0, limit);
  if (names.length > limit) visible.push(`… и ещё ${names.length - limit}`);
  return visible;
}
function writeBulkConfirmation(form, nodeId = '', filterNodeId = '') {
  if (!form) return;
  const confirmation = form.querySelector('[data-bulk-confirmation]');
  const filterNode = form.querySelector('[data-bulk-filter-node-id]');
  if (confirmation) confirmation.value = 'CONFIRMED';
  if (filterNode) filterNode.value = String(filterNodeId || clientDirectoryState.nodeId || '');
}
function syncBulkNodeActionWithFilter() {
  const select = document.getElementById('bulkRemoveNodeId');
  const label = document.getElementById('bulkRemoveNodeLabel');
  const hint = document.getElementById('bulkRemoveNodeHint');
  const button = document.getElementById('bulkRemoveNodeButton');
  if (!select) return;
  const nodeId = String(clientDirectoryState.nodeId || '');
  if (nodeId && Array.from(select.options).some(option => option.value === nodeId)) {
    select.value = nodeId;
    const selectedOption = select.selectedOptions?.[0];
    const nodeTitle = selectedOption?.textContent?.trim() || 'выбранного узла';
    const isRemnawave = selectedOption?.dataset?.nodeType === 'remnawave';
    if (label) label.textContent = `Удалить выбранных клиентов из узла «${nodeTitle}»`;
    if (hint) hint.textContent = isRemnawave
      ? 'У выбранных пользователей будет снят Internal Squad этого подключения Remnawave, затем удалены локальные связи Aggregator. Сами пользователи Remnawave и другие squads сохраняются.'
      : 'Фильтр и целевой узел совпадают. Будут обработаны только отмеченные клиенты; удаление подтверждается удалённой панелью до очистки связи в Aggregator.';
    if (button) button.textContent = isRemnawave ? 'Убрать из Remnawave' : 'Удалить из текущего узла';
    return;
  }
  if (label) label.textContent = 'Удалить выбранных клиентов из узла';
  if (hint) hint.textContent = 'Клиент удаляется или отвязывается в выбранной удалённой панели, затем локальная связь удаляется из Aggregator. В Remnawave снимается только настроенный Internal Squad.';
  if (button) button.textContent = 'Удалить из выбранного узла';
}
function fillApplySelectedClientIds(form, selected) {
  if (!form) return;
  form.querySelectorAll('input[data-apply-client-id]').forEach(input => input.remove());
  selected.forEach(id => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'client_ids';
    input.value = id;
    input.dataset.applyClientId = '1';
    form.appendChild(input);
  });
}
function openApplySelectedModal() {
  const selected = getUniqueClientSelection();
  if (!selected.size) {
    showToast('Сначала выберите клиентов, которых нужно добавить или обновить на узле');
    return false;
  }
  const form = document.getElementById('applySelectedForm');
  fillApplySelectedClientIds(form, selected);
  const summary = document.getElementById('applySelectedSummary');
  if (summary) summary.textContent = `Выбрано клиентов: ${selected.size}`;
  const names = getSelectedClientNames(selected, 10);
  const namesBox = document.getElementById('applySelectedNames');
  if (namesBox) namesBox.textContent = names.length ? `Будут обработаны: ${names.join(', ')}` : '';
  openModalById('applyAllModal');
  return false;
}
function prepareApplySelectedSubmit(event) {
  const selected = getUniqueClientSelection();
  if (!selected.size) {
    event?.preventDefault?.();
    showToast('Выбор клиентов снят. Отметьте клиентов заново.');
    return false;
  }
  const form = event?.currentTarget || document.getElementById('applySelectedForm');
  fillApplySelectedClientIds(form, selected);
  const nodeTitle = form?.querySelector('select[name="node_id"]')?.selectedOptions?.[0]?.textContent?.trim() || 'выбранный узел';
  const names = getSelectedClientNames(selected, 6);
  const namesText = names.length ? `\n\nКлиенты: ${names.join(', ')}` : '';
  return window.confirm(`Добавить или обновить ${selected.size} выбранных клиентов на узле «${nodeTitle}»?${namesText}`);
}
window.openApplySelectedModal = openApplySelectedModal;
window.prepareApplySelectedSubmit = prepareApplySelectedSubmit;

function confirmClientBulkAction(event) {
  const submitter = event?.submitter || document.activeElement;
  const action = String(submitter?.dataset?.bulkAction || 'delete-clients');
  const selected = getUniqueClientSelection();
  if (!selected.size) {
    showToast('Сначала выберите хотя бы одного клиента');
    event?.preventDefault?.();
    return false;
  }
  const form = event?.currentTarget;
  const selectedNames = getSelectedClientNames(selected, 6);
  const namesText = selectedNames.length ? `\n\nКлиенты: ${selectedNames.join(', ')}` : '';
  if (action === 'remove-node') {
    const select = form?.querySelector('#bulkRemoveNodeId');
    const nodeId = String(select?.value || '');
    if (!nodeId) {
      showToast('Выберите узел, из которого нужно удалить клиентов');
      select?.focus();
      event?.preventDefault?.();
      return false;
    }
    const nodeTitle = select?.selectedOptions?.[0]?.textContent?.trim() || 'выбранный узел';
    if (form) {
      form.dataset.loadingTitle = 'Удаляю клиентов из узла';
      form.dataset.loadingText = 'Сначала удаление подтверждается на 3x-ui, затем очищается локальная связь. При потере связи операция безопасно останавливается.';
    }
    const accepted = window.confirm(`Удалить ${selected.size} выбранных клиентов из узла «${nodeTitle}»?\n\nКлиенты останутся в агрегаторе и на остальных узлах.${namesText}`);
    if (accepted) {
      prepareUniqueClientIdsForSubmit(form, selected);
      writeBulkConfirmation(form, nodeId, clientDirectoryState.nodeId);
    }
    return accepted;
  }
  const deleteModeSelect = form?.querySelector('select[name="delete_mode"]');
  const modeLabel = deleteModeSelect?.selectedOptions?.[0]?.textContent?.trim() || 'выбранным способом';
  if (form) {
    form.dataset.loadingTitle = 'Удаляю выбранных клиентов';
    form.dataset.loadingText = 'Недоступные, отключённые и удалённые узлы будут пропущены без долгого ожидания.';
  }
  const accepted = window.confirm(`Удалить выбранных клиентов (${selected.size})?\nРежим: ${modeLabel}.${namesText}`);
  if (accepted) {
    prepareUniqueClientIdsForSubmit(form, selected);
    writeBulkConfirmation(form, clientDirectoryState.nodeId);
  }
  return accepted;
}
