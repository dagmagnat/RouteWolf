function setClientNodeSelection(button, checked) {
  const form = button && button.closest ? button.closest('form') : null;
  if (!form) return false;
  const boxes = Array.from(form.querySelectorAll('input[type="checkbox"].node-check, input[type="checkbox"][name^="node_enabled_"]'))
    .filter(cb => !cb.disabled);
  boxes.forEach(cb => {
    cb.indeterminate = false;
    cb.checked = !!checked;
    cb.dispatchEvent(new Event('input', { bubbles: true }));
    cb.dispatchEvent(new Event('change', { bubbles: true }));
  });
  const group = button.closest('.node-select-actions');
  if (group) group.querySelectorAll('[data-node-check-set]').forEach(other => {
    const active = other === button;
    other.classList.toggle('is-active', active);
    other.setAttribute('aria-pressed', active ? 'true' : 'false');
  });
  showToast(checked ? `Выбраны все узлы: ${boxes.length}` : 'Выбор узлов снят');
  return false;
}
window.setClientNodeSelection = setClientNodeSelection;

function setupMobileClientFilters() {
  const tabs = document.querySelector('.mobile-client-tabs');
  if (!tabs) return;
  const cards = Array.from(document.querySelectorAll('[data-mobile-client-card]'));
  let empty = document.querySelector('[data-mobile-client-empty]');
  if (!empty) {
    empty = document.createElement('div');
    empty.className = 'mobile-filter-empty';
    empty.dataset.mobileClientEmpty = '1';
    empty.textContent = 'По этому фильтру клиентов нет.';
    const list = document.querySelector('.mobile-client-cards');
    if (list) list.after(empty);
  }
  function applyMobileClientFilter(filter, activeBtn) {
    let visibleCount = 0;
    tabs.querySelectorAll('[data-mobile-client-filter]').forEach(b => {
      b.classList.toggle('is-active', b === activeBtn || (!activeBtn && b.dataset.mobileClientFilter === filter));
    });
    cards.forEach(card => {
      const keys = String(card.dataset.statuses || '').split(/\s+/).filter(Boolean);
      const show = filter === 'all' || keys.includes(filter);
      card.classList.toggle('is-filter-hidden', !show);
      if (show) visibleCount += 1;
    });
    empty.classList.toggle('is-visible', visibleCount === 0);
  }
  tabs.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mobile-client-filter]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    applyMobileClientFilter(btn.dataset.mobileClientFilter || 'all', btn);
  });
  applyMobileClientFilter('all');
}
async function refreshClientOnlineSummary() {
  const target = document.getElementById('clientOnlineNowCount');
  if (!target) return;
  target.textContent = '…';
  try {
    const response = await fetch('/dashboard/online-clients.json', { headers: { Accept: 'application/json' } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Ошибка проверки');
    const list = Array.isArray(data.clients) ? data.clients : [];
    const onlineIds = new Set(list.map(item => String(item.id || item.clientId || item.client_id || '')).filter(Boolean));
    target.textContent = String(onlineIds.size);
    target.title = data.errors?.length ? data.errors.join(' | ') : 'Онлайн получен с активных узлов';
    document.querySelectorAll('[data-modern-online-state]').forEach(state => {
      if (state.dataset.onlineEligible !== '1') return;
      const isOnline = onlineIds.has(String(state.dataset.clientId || ''));
      state.classList.toggle('online', isOnline);
      state.classList.toggle('offline', !isOnline);
      const label = state.querySelector('b');
      if (label) label.textContent = isOnline ? 'В сети' : 'Не в сети';
      const onlineClient = list.find(item => String(item.id || item.clientId || item.client_id || '') === String(state.dataset.clientId || ''));
      state.title = isOnline && Array.isArray(onlineClient?.nodes)
        ? onlineClient.nodes.map(node => node.publicName || node.name || 'Узел').join(', ')
        : '';
    });
  } catch (err) {
    target.textContent = '—';
    target.title = err.message || String(err);
  }
}

let clientSpeedRefreshPending = false;
async function refreshClientSpeedSummary() {
  const cells = Array.from(document.querySelectorAll('[data-modern-speed-client]'));
  if (!cells.length || clientSpeedRefreshPending) return;
  clientSpeedRefreshPending = true;
  try {
    const response = await fetch('/dashboard/live-client-traffic.json?refresh=1&limit=500&min_mbps=0', { headers: { Accept: 'application/json' } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Ошибка загрузки скорости');
    const rows = Array.isArray(data.clients) ? data.clients : [];
    const byId = new Map(rows.map(row => [String(row.clientId || row.client_id || ''), row]));
    cells.forEach(cell => {
      const row = byId.get(String(cell.dataset.modernSpeedClient || ''));
      if (!row) {
        cell.textContent = 'Нет трафика';
        cell.classList.remove('is-active');
        return;
      }
      const active = Number(row.totalMbps || 0) > 0.001;
      cell.classList.toggle('is-active', active);
      cell.innerHTML = active
        ? `<span>↓ ${String(row.downloadText || '0 Мбит/с')}</span><span>↑ ${String(row.uploadText || '0 Мбит/с')}</span>`
        : '<span class="modern-speed-idle">Нет трафика</span>';
      cell.title = `Всего: ${String(row.totalText || '0 Мбит/с')}`;

      const traffic = cell.closest('tr')?.querySelector('[data-modern-traffic-client]');
      if (traffic) {
        const usedLabel = traffic.querySelector(':scope > div:first-child span');
        if (usedLabel) usedLabel.textContent = String(row.currentTotalText || '0 Б');
        const track = traffic.querySelector('.modern-traffic-track i');
        const limitGb = Math.max(0, Number(traffic.dataset.trafficLimitGb || 0));
        const used = Math.max(0, Number(row.currentUsed || 0));
        const percent = limitGb > 0 ? Math.min(100, used / (limitGb * 1024 ** 3) * 100) : (used > 0 ? 100 : 0);
        if (track) track.style.width = `${percent.toFixed(1)}%`;
      }
    });
  } catch (_) {
    cells.forEach(cell => { if (!cell.textContent.trim()) cell.textContent = '—'; });
  } finally {
    clientSpeedRefreshPending = false;
  }
}

function setupClientOverviewShortcuts() {
  document.querySelectorAll('[data-client-status-shortcut]').forEach(button => {
    button.addEventListener('click', () => {
      const mode = button.dataset.clientStatusShortcut || 'newest';
      const sort = document.getElementById('clientSortMode');
      if (!sort) return;
      sort.value = mode === 'active' ? 'newest' : mode;
      if (mode === 'active') {
        const mobile = document.querySelector('[data-mobile-client-filter="active"]');
        if (mobile) mobile.click();
      } else {
        sort.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  setupMobileClientFilters();
  setupClientOverviewShortcuts();
  refreshClientOnlineSummary();
  refreshClientSpeedSummary();
  window.setInterval(() => {
    if (document.hidden) return;
    refreshClientOnlineSummary();
    refreshClientSpeedSummary();
  }, 10000);
  document.querySelectorAll('.client-check[data-client-id]').forEach(cb => {
    cb.addEventListener('change', () => {
      syncClientCheckboxCopies(cb);
      const selected = getUniqueClientSelection();
      const all = getAllClientIdsOnPage();
      document.querySelectorAll('.clients-table thead input[type="checkbox"]').forEach(master => {
        master.checked = all.size > 0 && selected.size === all.size;
        master.indeterminate = selected.size > 0 && selected.size < all.size;
      });
      updateBulkSelectionUi();
    });
  });
  updateBulkSelectionUi();
  const editId = new URLSearchParams(window.location.search).get('edit');
  if (editId && document.getElementById('clientEditor-' + editId)) openClientEditor(editId);
  const vpnService = document.getElementById('clientsVpnService');
  const vpnForm = document.getElementById('clientsVpnCreateForm');
  if (vpnService && vpnForm) {
    const syncAction = () => { vpnForm.action = '/vpn/services/' + encodeURIComponent(vpnService.value) + '/clients'; };
    vpnService.addEventListener('change', syncAction);
    syncAction();
  }
  setupClientDirectory();
  if (!clientDirectoryMode) {
    document.querySelectorAll('form[data-live-client-search]').forEach(form => {
      const input = form.querySelector('input[name="q"]');
      if (!input) return;
      let timer = null;
      let lastSubmitted = String(input.value || '');
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          const value = String(input.value || '');
          if (value === lastSubmitted) return;
          lastSubmitted = value;
          if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
        }, 650);
      });
    });
  }
});
function setOperationNodeSelection(button, name, checked) {
  const form = button && button.closest ? button.closest('form') : null;
  if (!form) return false;
  form.querySelectorAll('input[type="checkbox"][name="' + name + '"]').forEach(input => {
    if (!input.disabled) input.checked = Boolean(checked);
  });
  return false;
}

function syncImportTargetSource(form) {
  if (!form) return;
  const source = form.querySelector('[data-import-source]');
  const sourceId = String(source && source.value || '');
  form.querySelectorAll('input[name="target_node_ids"]').forEach(input => {
    const isSource = String(input.value) === sourceId;
    input.disabled = isSource;
    if (isSource) input.checked = false;
    const row = input.closest('.node-item');
    if (row) {
      row.classList.toggle('disabled', isSource);
      row.title = isSource ? 'Это узел-источник; он не перезаписывается при импорте.' : '';
    }
  });
}

function syncImportModeUi(form) {
  if (!form) return;
  const mode = form.querySelector('[data-import-mode]');
  const box = form.querySelector('[data-import-target-box]');
  const enabled = String(mode && mode.value || 'local') === 'selected';
  if (box) box.hidden = !enabled;
  form.querySelectorAll('input[name="target_node_ids"]').forEach(input => {
    if (!enabled) input.checked = false;
  });
  syncImportTargetSource(form);
}

function validateLongOperationSelection(event) {
  const form = event.target;
  if (!(form instanceof HTMLFormElement)) return;
  if (form.matches('form[action="/clients/import"]')) {
    const mode = String(form.querySelector('[name="import_mode"]')?.value || 'local');
    const selected = form.querySelectorAll('input[name="target_node_ids"]:checked:not(:disabled)').length;
    if (mode === 'selected' && selected === 0) {
      event.preventDefault();
      alert('Отметьте хотя бы один целевой узел. Узел-источник автоматически исключён.');
      return;
    }
    if (mode === 'selected' && !confirm('Импорт затронет только отмеченные целевые узлы: ' + selected + '. Продолжить?')) {
      event.preventDefault();
      return;
    }
  }
  if (form.matches('form[action="/clients/sync-nodes"]')) {
    const selected = form.querySelectorAll('input[name="node_ids"]:checked:not(:disabled)').length;
    if (selected === 0) {
      event.preventDefault();
      alert('Отметьте хотя бы один узел для синхронизации.');
      return;
    }
    if (!confirm('Будут созданы или обновлены клиенты на выбранных узлах: ' + selected + '. Продолжить?')) {
      event.preventDefault();
    }
  }
}
document.addEventListener('submit', validateLongOperationSelection, true);

function showLoading(title, text) {
  const modal = document.getElementById('loadingModal');
  if (!modal) return;
  document.getElementById('loadingTitle').textContent = title || 'Загрузка';
  document.getElementById('loadingText').textContent = text || 'Операция выполняется. Не закрывайте страницу.';
  modal.classList.remove('hidden');
}
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('form.import-sync-form').forEach(form => syncImportModeUi(form));
  document.querySelectorAll('form.js-long-action').forEach(form => {
    form.addEventListener('submit', (event) => {
      if (!event.defaultPrevented) showLoading(form.dataset.loadingTitle, form.dataset.loadingText);
    });
  });
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-node-check-set]');
    if (!btn || event.defaultPrevented) return;
    event.preventDefault();
    setClientNodeSelection(btn, btn.dataset.nodeCheckSet === 'all');
  });
});
document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  const openModal = Array.from(document.querySelectorAll('#createClientModal, #createVpnClientModal, [id^="clientEditor-"], [id^="vpnClientEditor-"]')).find(modal => !modal.classList.contains('hidden'));
  if (openModal) { openModal.classList.add('hidden'); syncClientModalScrollLock(); }
});
</script>

