#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=09

start_service() {
    [ -x /etc/init.d/routewolf ] || return 0
    procd_open_instance
    procd_set_param command /etc/routewolf-subscription/controller monitor
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    /etc/routewolf-subscription/controller stop
}
