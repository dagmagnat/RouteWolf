#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    [ -x /etc/init.d/routewolf ] || return 0
    procd_open_instance
    if grep -qx xray /etc/routewolf-subscription/engine 2>/dev/null; then
        procd_set_param command /usr/bin/xray run -c /etc/routewolf-subscription/config.json
    else
        procd_set_param command /usr/bin/sing-box run -c /etc/routewolf-subscription/config.json
    fi
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
